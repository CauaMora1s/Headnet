# Headnet environment variables.
#
# Copy to .env for local development. Every setting in headnet.yaml has an
# equivalent variable, and the environment always wins over the file.
#
# NEVER COMMIT A FILLED-IN .env FILE. It is listed in .gitignore for exactly
# that reason. The values below are placeholders, not credentials.
#
# Full reference: docs/configuration.md

# --- Core -------------------------------------------------------------------

# development or production.
HEADNET_ENVIRONMENT=development

# --- Server -----------------------------------------------------------------

HEADNET_SERVER_LISTEN=:8080

# The URL clients actually reach this server on. In production this must be
# https:// unless you set HEADNET_SERVER_ALLOW_INSECURE_HTTP.
HEADNET_SERVER_BASE_URL=http://localhost:8080

# Set to true only when a reverse proxy terminates TLS in front of Headnet.
# HEADNET_SERVER_ALLOW_INSECURE_HTTP=false

# HEADNET_SERVER_READ_TIMEOUT=15s
# HEADNET_SERVER_WRITE_TIMEOUT=30s
# HEADNET_SERVER_IDLE_TIMEOUT=120s
# HEADNET_SERVER_SHUTDOWN_TIMEOUT=20s
# HEADNET_SERVER_MAX_BODY_BYTES=1048576

# --- Database ---------------------------------------------------------------

HEADNET_DATABASE_DRIVER=sqlite
HEADNET_DATABASE_PATH=./data/headnet.db

# PostgreSQL. This is the one setting that carries a secret, which is why it
# belongs here rather than in the YAML file. Replace the placeholder before
# use; it is not a working credential.
# HEADNET_DATABASE_DRIVER=postgres
# HEADNET_DATABASE_DSN=postgres://headnet:CHANGE_ME@localhost:5432/headnet?sslmode=require

# HEADNET_DATABASE_MAX_OPEN_CONNS=25
# HEADNET_DATABASE_MAX_IDLE_CONNS=5
# HEADNET_DATABASE_CONN_MAX_LIFETIME=30m

# --- Network ----------------------------------------------------------------

# Changing these after devices are enrolled requires re-addressing all of them.
HEADNET_NETWORK_IPV4_CIDR=100.100.0.0/16
HEADNET_NETWORK_IPV6_CIDR=fd7a:115c:a1e0::/48

# --- Authentication ---------------------------------------------------------

# Comma-separated. Supported: local, oidc. Not implemented yet (Phase 1).
HEADNET_AUTH_PROVIDERS=local

# --- Logging ----------------------------------------------------------------

HEADNET_LOG_LEVEL=info
# json in production, text when reading logs in a terminal.
HEADNET_LOG_FORMAT=text
# HEADNET_LOG_ADD_SOURCE=false

# --- Rate limiting ----------------------------------------------------------

HEADNET_RATE_LIMIT_ENABLED=true
HEADNET_RATE_LIMIT_REQUESTS_PER_MINUTE=120
HEADNET_RATE_LIMIT_BURST=30

# --- Observability ----------------------------------------------------------

# /metrics is unauthenticated. Not implemented yet (Phase 12).
HEADNET_OBSERVABILITY_METRICS_ENABLED=false

# --- Relay ------------------------------------------------------------------

# Not implemented yet (Phase 5).
HEADNET_RELAY_ENABLED=false
